# PromptLab's external Supabase project. In Lovable, use these unique names
# instead of SUPABASE_* because Lovable reserves those variable names.
PROMPTLAB_SUPABASE_URL=https://your-project.supabase.co
PROMPTLAB_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
PROMPTLAB_SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Browser-side configuration; keep URL and publishable key on the same project.
VITE_SUPABASE_PROJECT_ID=your-supabase-project-id
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional Maya 2 Native text-to-speech server. The model runs separately from PromptLab.
# For local dev only, run the Maya server on this same machine at 127.0.0.1:8080.
# In hosted Lovable, this must be a secure, privately reachable inference endpoint;
# 127.0.0.1 would refer to the hosted application server, not your laptop.
MAYA_TTS_BASE_URL=http://127.0.0.1:8080
# Optional: bearer token required by a protected reverse proxy in front of Maya's server.
# The upstream Maya reference server itself does not implement authentication.
MAYA_TTS_BEARER_TOKEN=

# Other server-only secrets. Never use a VITE_ prefix for these.
LOVABLE_API_KEY=replace-with-lovable-ai-gateway-key
OPENAI_API_KEY=replace-with-openai-api-key
PROMPTLAB_ADMIN_USER_IDS=your-supabase-auth-user-uuid
