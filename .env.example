# Public Supabase project configuration (the publishable key is intended for client use).
SUPABASE_PROJECT_ID=your-supabase-project-id
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Vite client-side equivalents; these values are public configuration, not secrets.
VITE_SUPABASE_PROJECT_ID=your-supabase-project-id
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only secrets. Never use a VITE_ prefix for these.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
LOVABLE_API_KEY=replace-with-lovable-ai-gateway-key
OPENAI_API_KEY=replace-with-openai-api-key
PROMPTLAB_ADMIN_USER_IDS=your-supabase-auth-user-uuid
